{
  "Jwt": {
    "Issuer": "LoanPlatform.ApiGateway",
    "Audience": "LoanPlatform"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "scoring-swagger-route": {
        "ClusterId": "scoring-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/scoring/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/scoring"
          }
        ]
      },
      "scoring-openapi-route": {
        "ClusterId": "scoring-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/scoring/openapi/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/scoring"
          }
        ]
      },
      "scoring-route": {
        "ClusterId": "scoring-cluster",
        "Match": {
          "Path": "/api/scoring/{**catch-all}"
        }
      },
      "loancore-route": {
        "ClusterId": "loancore-cluster",
        "Match": {
          "Path": "/api/loans/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "loancore-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "scoring-cluster": {
        "Destinations": {
          "scoring-api": {
            "Address": "http://localhost:5182/"
          }
        }
      },
      "loancore-cluster": {
        "Destinations": {
          "loancore-api": {
            "Address": "http://loancore-api:8080/"
          }
        }
      }
    }
  }
}