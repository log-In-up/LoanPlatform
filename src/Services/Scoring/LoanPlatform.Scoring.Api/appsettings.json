{
  "ConnectionStrings": {
    "ScoringDatabase": "Host=localhost;Port=5432;Database=loanplatform_scoring;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "TaxAuthority": {
    "BaseUrl": "http://localhost:5002/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "LoanPlatform.Scoring.Api"
    }
  },
  "AllowedHosts": "*"
}
